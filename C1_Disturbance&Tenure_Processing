# Focal mode

get_mode <- function(x, ...) {
  x <- x[!is.na(x)]
  
  if (length(x) == 0) {
    return(NA_integer_)
  }
  
  tab <- table(x)
  as.integer(names(tab)[which.max(tab)])
}


