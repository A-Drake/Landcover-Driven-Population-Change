require(terra)
require(sf)

# Clean workspace ---------------------------
terra::tmpFiles(current=T,orphan=T,old=T,remove=T)

# Get directories ------------------------------------
input<-root <- "C:/Users/andrake/OneDrive - NRCan RNCan/Desktop/Partitioning Change2"
root2 <- "G:/Shared drives/BAM_NationalModels5"

# Template used for V5 prediction layers:
rast1k <- rast(nrows=4527, ncols=7300, xmin=-4100000, xmax=3200000, ymin=1673000, ymax=6200000, crs = "EPSG:5072")

# ----------------------------------------------------------
# Shapefiles
# ----------------------------------------------------------

can <- read_sf(file.path(root2, "Regions", "CAN_adm", "CAN_adm0.shp")) |> 
  st_transform(crs=crs("EPSG:5072")) # Canadian boundary

bcr<- read_sf(file.path(root2, "Regions","BAM_BCR_NationalModel.shp")) |>
  st_transform(crs=crs("EPSG:5072"))|> st_intersection(can)
bcr$subUnit<-paste0("can",bcr$subUnit)

lakes<- read_sf(file.path(input,"WaterMask_Canada.shp"))

# ----------------------------------------------------------
# CanLad layers 1985-2025
# ----------------------------------------------------------
# Year ---
dST<-rast(file.path(input,"Disturbance","canlad_1985_2025_latest_start_year_v1_1_20260508.tif"))
# Type ----
dTyp<-rast(file.path(input,"Disturbance","canlad_1985_2025_latest_type_v1_1_20260508.tif"))
dTyp <- subst(dTyp, from = c(7,8), to = 6) # make defoliation all one class regardless of intensity

# ----------------------------------------------------------
# Get pre-canLad layer 
# ----------------------------------------------------------
# Disturbance year ----------
pdST<-rast(file.path(input,"Disturbance","preCanlad_disturbanceYear_v2_20251126.tif"))
# Type ----
pdTyp<-rast(file.path(input,"Disturbance","preCanlad_disturbanceType_v2_20251126.tif"))

# preCanlad Pixel values are disturbance type:
#2 = Fire
#3 = Harvest
#4 = Insect

# Align coding with CanLad -----
pdTyp <- subst(pdTyp, from = c(2, 3, 4), to = c(1, 2, 6))

# Fill any blanks in dType with pdTyp to get latest disturbance 1965-2025 -----
sharedType <- cover(dTyp, pdTyp)
sharedTime <- cover(dST, pdST)

#No-disturbance should count so add in as 999 -----
sharedType_na <- subst(sharedType, from=NA, to=999)

#Unknown disturbance date - following data recommendations -> 1955
sharedTime<- subst(sharedTime, from =999, to =1955)
sharedTime_na <- subst(sharedTime, from=NA, to=999)

# remove NA values out of boundary and anything in water ------
canp <-can|> st_transform(crs=crs(sharedType_na)) # Canadian boundary
lakes<-lakes|> st_transform(crs=crs(sharedType_na)) # water bodies

sharedType_na<-sharedType_na%>%mask(canp)%>%mask(lakes, inverse=T)
sharedTime_na<-sharedTime_na%>%mask(canp)%>%mask(lakes, inverse=T)

# Save files -------------
writeRaster(sharedType_na,file.path(input,"CombinedDisturbanceType_na.tif"))
writeRaster(sharedTime_na,file.path(input,"CombinedDisturbanceDate_na.tif"))

sharedType_na<-rast(file.path(input,"CombinedDisturbanceType_na.tif"))
sharedTime_na<-rast(file.path(input,"CombinedDisturbanceDate_na.tif"))

# Make 1km with mode *but need to match* how the data was derived for SCANFI in V5 (bilinear of closest 4 pixels) -----------------------

sharedType_na1k <- terra::project(sharedType_na,rast1k, method="near", mask = FALSE)
sharedTime_na1k <- terra::project(sharedTime_na,rast1k, method="near", mask = FALSE)

# Save out ----
writeRaster(sharedType_na1k,file.path(input,"CombinedDisturbanceType1k.tif"))
writeRaster(sharedTime_na1k,file.path(input,"CombinedDisturbanceTime1k.tif"))

#----------------------------------------------
# Now Land Tenure (2020 layer) 
#----------------------------------------------
# https://storymaps.arcgis.com/stories/52b71ae81a4e4ccba5771a42c2a32b25

Tenure<- rast(file.path(root,"Canada_MFv2020", "Canada_MFv2020.tif"))

# Project using same approach for V5 prediction layers -----
Tenure_1k <- terra::project(Tenure,rast1k, method="near", mask = FALSE)

# Mask ---
Tenure_1k<-Tenure_1k %>%mask(sharedTime_na1k)

# Save out ---
writeRaster(Tenure_1k,file.path(input,"LandTenure1k.tif"), overwrite=T)

