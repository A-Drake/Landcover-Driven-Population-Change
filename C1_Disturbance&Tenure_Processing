########################################################################################
# -------------------------------------------------------
# Disturbance event layer with type-year coding
# -------------------------------------------------------
#######################################################################################

# For interpretation we don't want pixel-level values but total effects of disturbance "events" - i.e. 
# sum predictions over the disturbance footprint to calculate the effect of e.g. fire A in 1989 as opposed to fire B in 1990

# We therefore need to ID contiguous patches of events e.g. the whole fire footprint -
# and use this for tallying. Disturbance is patchy so allow 2km gaps within-events using a buffer to merge footprint
# (logging harvest/same fire event) and then bring back to actual area with a mask 

# this is very computationally heavy so code keeps rasters out of direct memory ---------------

# -------------------------------------------------------
# Create a disturbance event ID to summarize outputs
# CanLAD disturbance type + year
# ------------------------------------------------------------

# Code no-disturbance as 0 ---------------------
CanType <- rast(file.path(root, "CombinedDisturbanceType1k.tif"))
CanType <- subst(CanType, from = 999, to = 0)

CanTime <- rast(file.path(root, "CombinedDisturbanceTime1k.tif"))
CanTime <- subst(CanTime, from = 999, to = 0)

# Ensure agreement ------------------------
CanTime[CanType == 0] <- 0
CanType[CanTime == 0] <- 0

# ------------------------------------------------------------
# Create type-year ID
# ------------------------------------------------------------

# Use the original type and time directly -------------
TypeYear <- CanType * 10000 + CanTime

# Keep only disturbance types of interest (harvest, fire, insect and insect + harvest) --------------
TypeYear <- ifel(CanType %in% c(1, 2, 5, 6), TypeYear,NA)

# Write to disk and remove -----
TypeYear_file <- file.path(root2, "CanLAD_TypeYear.tif")

writeRaster(TypeYear,TypeYear_file,datatype = "INT4S",overwrite = TRUE)
rm(TypeYear)
gc()

# bring in without loading ----
TypeYear <- rast(TypeYear_file)

# ------------------------------------------------------------
# Unique type-year combinations
# ------------------------------------------------------------

freq_tab <- freq(TypeYear)
unique_ids <- freq_tab$value
unique_ids <- unique_ids[!is.na(unique_ids)]
max(freq_tab$count) # 100,000 is a safe multiplier 

# ------------------------------------------------------------
# Prepare output directory
# ------------------------------------------------------------

event_dir <- file.path(root,"CanLAD_Event_Temp")
dir.create(event_dir,showWarnings = FALSE,recursive = TRUE)

# ------------------------------------------------------------
# Process each Type × Year
# ------------------------------------------------------------

# add focal window for bridging <2km gaps in contiguous events -------
gap_window <- matrix(1,nrow = 5,ncol = 5)

for (i in seq_along(unique_ids)) {
  
  val <- unique_ids[i]
  
  message("\n")
  message("Processing at", round(i/length(unique_ids),2),"% : ", val)
  
  # ----------------------------------------------------------
  # Limit to Type × Year
  # ----------------------------------------------------------
  mask <- ifel(TypeYear == val,1,NA)
  
  # ----------------------------------------------------------
  # Confirm there is data, else skip ---
  # ----------------------------------------------------------
  
  n_cells <- global(!is.na(mask),"sum",na.rm = TRUE)[1, 1]
  
  if (is.na(n_cells) || n_cells == 0) {message("No cells -- skipping")
    rm(mask)
    next
  }
  
  # ----------------------------------------------------------
  # Crop to extent of disturbances to save memory
  # ----------------------------------------------------------
  
  mask <- trim(mask)

  # Bridge gaps ----------
  buffered <- focal(mask,w = gap_window,fun = "max",na.rm = TRUE,na.policy = "all")

  # Identify contiguous patches --------
  p <- patches(buffered,directions = 8,allowGaps = TRUE)

  # Limit to detected disturbance cells ----------
  patch_masked_file <- file.path(event_dir,paste0("patches_masked_", val, ".tif"))
  p <- mask(p,mask,filename = patch_masked_file,overwrite = TRUE)

  rm(mask, buffered)
  gc()
  
  # Make ID unique by disturbance event -----
  p <- p + val*100000
  event_file <- file.path(event_dir,paste0("events_",val,".tif"))
  writeRaster(p,event_file,datatype = "INT8S",overwrite = TRUE)
  rm(p)
  gc()
  
} # end of all event-dates

# ----------------------------------------------------------
# Get all event files and merge 
# ----------------------------------------------------------

event_files <- list.files(event_dir,pattern = "^events_[0-9]+\\.tif$",full.names = TRUE)
events <- do.call(merge,lapply(event_files, rast))

# ----------------------------------------------------------
# write out final file 
# ----------------------------------------------------------

writeRaster(events,file.path(root,"DisturbanceEvents.tif"),datatype = "INT8S",overwrite = TRUE)
