# Reduce to just the required layers----

stack.i <- subset(pred.i, names(pred.i) %in% b.list[[1]]$var.names)

prediction<-list()
names<-c()

for (j in c(1:32)){ #each bootstrap
  b.i <- b.list[[j]]
  
  #3. Predict----
  prediction[[j]] <- try(terra::predict(stack.i,b.i, type="response"))
  if(inherits(prediction[[j]], "try-error")){ return(NULL)}
  rm("b.i")
  print(j)
  names<-c(names,paste0(year.i,"_b",j)) # keep a list of names
  gc()
} # end of boots

print(paste0("Done ",year.i,spp.i))
output<-rast(prediction)
names(output)<-names
terra::writeRaster(output, file.path(out, paste0(bcrn.i,"_LandChangeOnly","_", spp.i,"_",year.i,".tif")), overwrite=TRUE)
