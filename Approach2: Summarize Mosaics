library(terra)
library(dplyr)
library(tidyr)
library(purrr)
library(sf)
library(data.table)

# Call Values ------
#years <- seq(1985, 2020, by = 5)
years <- c(1990, 2020)
nboot <- 32

#--------------------------------------------------------------------------------
# Function to summarize rasters across different land-divisions/conditions
#--------------------------------------------------------------------------------

process_species <- function(can, bcr.i, spp.i,mask,root2, wshed.i, wshed10.i, tenure.i, watermask.i, FMU.i, distevent.i) {

    
    print(paste0("Running ", spp.i))

    results <- list()
    
    for (yr in years) {
      
      print(paste0("Year ", yr))
      f <- file.path(root2,paste0(spp.i, "_", yr, ".tif"))
      
# Check if file exists, else skip (redundant with the year check) ---------------------
   if (!file.exists(f)) { stop(paste("Missing:", f))
   }
      
     # Import if does --------------- 
      r.i <- rast(f) # prediction outputs
    
# Check that there are 32 bootstrap estimates, else skip -------------
   if (nlyr(r.i) != nboot) {
   stop(paste0(spp.i, " ", yr, " has ", nlyr(r.i), " layers rather than ", nboot))
   }
      
      # Crop, mask, and remove water ----------------
      r <- r.i %>%crop(mask) %>% mask(vect(watermask.i), inverse = TRUE) %>%mask(mask)
      
      # Binary raster for sample size (excluding water) ----------------
      r_valid <- ifel(is.na(r[[1]]), 0, 1) %>% crop(mask)%>% mask(mask)
      
      # ---------------------------------------------------------
      # 1. WHOLE CANADA
      # ---------------------------------------------------------
      
      # Sum abundance across all pixels for each bootstrap ---------
      can_sum <- global(r, fun = "sum", na.rm = TRUE)
      can_n <- global(r_valid, fun = "sum", na.rm = TRUE)
      
      can_df <- data.frame(
        spp = spp.i,
        YEAR = yr,
        boot = seq_len(nrow(can_sum)),
        spatial_level = "Canadawide",
        spatial_id = "CanadaSppExtent",
        total_pixels = can_n[, 1],
        abundance = can_sum[, 1]
      )
      
rm(can_sum,can_n)
gc()
      print("done Canada stats")
            
      # ---------------------------------------------------------
      # 2. BCR summary
      # ---------------------------------------------------------
      if (nrow(bcr.i) > 0) { # conditional on data existing -----
      bc_vals <- terra::extract(r, bcr.i, fun = sum, na.rm = TRUE)    
      bc_npix <- terra::extract(r_valid, bcr.i, fun = sum, na.rm = TRUE) # sum pixels with valid ----
      sub_map <- data.frame(ID = 1:nrow(bcr.i), spatial_id = as.character(bcr.i$subUnit))
       
     bcr_df <- bc_vals %>%
        left_join(sub_map, by = "ID") %>%
        select(-ID) %>%
        pivot_longer(cols = -spatial_id, names_to = "boot_name", values_to = "abundance") %>%
        left_join(
          data.frame(ID = 1:nrow(bcr.i), total_pixels = bc_npix[, 2]) %>% 
          left_join(sub_map, by = "ID") %>% select(-ID),
          by = "spatial_id"
        ) %>%
        group_by(spatial_id) %>%
        mutate(spp = spp.i, YEAR = yr, spatial_level = "BCR", boot = row_number()) %>%
        ungroup() %>%
        select(spp, YEAR, boot, spatial_level, spatial_id, abundance, total_pixels)
        
rm(bc_vals,bc_npix)
gc()
        
      } else {
  print("No BCRs in this region. Skipping BCR stats.")
  bcr_df <- data.frame() # Empty placeholder
}
print("done BCR stats")

      
      # ---------------------------------------------------------
      # 2. SUBBASIN
      # ---------------------------------------------------------
      if (nrow(wshed.i) > 0) { # conditional on data existing -----
      w_vals <- terra::extract(r, wshed.i, fun = sum, na.rm = TRUE)    
      w_npix <- terra::extract(r_valid, wshed.i, fun = sum, na.rm = TRUE) # sum pixels with valid ----
      sub_map <- data.frame(ID = 1:nrow(wshed.i), spatial_id = as.character(wshed.i$HYBAS_ID))
       
     sub_df <- w_vals %>%
        left_join(sub_map, by = "ID") %>%
        select(-ID) %>%
        pivot_longer(cols = -spatial_id, names_to = "boot_name", values_to = "abundance") %>%
        left_join(
          data.frame(ID = 1:nrow(wshed.i), total_pixels = w_npix[, 2]) %>% 
          left_join(sub_map, by = "ID") %>% select(-ID),
          by = "spatial_id"
        ) %>%
        group_by(spatial_id) %>%
        mutate(spp = spp.i, YEAR = yr, spatial_level = "subbasin", boot = row_number()) %>%
        ungroup() %>%
        select(spp, YEAR, boot, spatial_level, spatial_id, abundance, total_pixels)
        
rm(w_vals,w_npix)
gc()
        
      } else {
  print("No subbasins found in this region. Skipping subbasin stats.")
  sub_df <- data.frame() # Empty placeholder
}
print("done Subbasin stats")


      
      # ---------------------------------------------------------
      # 3. SUBBASIN 10
      # ---------------------------------------------------------
      if (nrow(wshed10.i) > 0) { # conditional on data existing -----
      w10_vals <- terra::extract(r, wshed10.i, fun = sum, na.rm = TRUE)    
      w10_npix <- terra::extract(r_valid, wshed10.i, fun = sum, na.rm = TRUE) # sum pixels with valid ----
      sub10_map <- data.frame(ID = 1:nrow(wshed10.i), spatial_id = as.character(wshed10.i$HYBAS_ID))
       
     sub10_df <- w10_vals %>%
        left_join(sub10_map, by = "ID") %>%
        select(-ID) %>%
        pivot_longer(cols = -spatial_id, names_to = "boot_name", values_to = "abundance") %>%
        left_join(
          data.frame(ID = 1:nrow(wshed10.i), total_pixels = w10_npix[, 2]) %>% 
          left_join(sub10_map, by = "ID") %>% select(-ID),
          by = "spatial_id"
        ) %>%
        group_by(spatial_id) %>%
        mutate(spp = spp.i, YEAR = yr, spatial_level = "subbasin_Lev10", boot = row_number()) %>%
        ungroup() %>%
        select(spp, YEAR, boot, spatial_level, spatial_id, abundance, total_pixels)
        
rm(w10_vals,w10_npix)
gc()
        
      } else {
  print("No subbasins found in this region. Skipping subbasin stats.")
  sub10_df <- data.frame() # Empty placeholder
}
print("done Subbasin stats")

# ---------------------------------------------------------
# 4. Forest Management Unit - split by BCR so in patches
# ---------------------------------------------------------
      if (nrow(FMU.i) > 0) {
      e_vals <- terra::extract(r, FMU.i, fun = sum, na.rm = TRUE)
      e_npix <- terra::extract(r_valid, FMU.i, fun = sum, na.rm = TRUE)# sum pixels with valid ---- 
      fmu_map <- data.frame(ID = 1:nrow(FMU.i), spatial_id = as.character(FMU.i$FMU_Nam))
      
# Aggregate e_vals by spatial_id while keeping all bootstrap columns
val_summary <- e_vals %>%
    left_join(fmu_map, by = "ID") %>%
    select(-ID) %>%
    group_by(spatial_id) %>%
    summarise(across(everything(), \(x) sum(x, na.rm = TRUE)), .groups = "drop")
  
# Aggregate total pixels uniquely by spatial_id
  pixel_summary <- data.frame(ID = 1:nrow(FMU.i), total_pixels = e_npix[, 2]) %>%
    left_join(fmu_map, by = "ID") %>%
    group_by(spatial_id) %>%
    summarise(total_pixels = sum(total_pixels, na.rm = TRUE), .groups = "drop")
    
  FMU_df <- val_summary %>%
    pivot_longer(cols = -spatial_id, names_to = "boot_name", values_to = "abundance") %>%
    left_join(pixel_summary, by = "spatial_id") %>%
    group_by(spatial_id) %>%
    mutate(spp = spp.i, YEAR = yr, spatial_level = "FMU", boot = row_number()) %>%
    ungroup() %>%
    select(spp, YEAR, boot, spatial_level, spatial_id, abundance, total_pixels)

  rm(e_vals, e_npix, val_summary, pixel_summary)
  gc()

 } else {
  print("No FMUs found in this region. Skipping FMU stats.")
  FMU_df <- data.frame() # Empty placeholder
}


print("done Forest Management Unit stats")
      
      
      # ---------------------------------------------------------
      # 5. TENURE
      # ---------------------------------------------------------
      
      tenure_sum <- terra::zonal(r, tenure.i,fun = "sum",na.rm = TRUE)
      
      tenure_npix <- terra::zonal(r_valid, tenure.i,fun = "sum",na.rm = TRUE)%>%
        rename(spatial_id = 1,total_pixels = 2)%>% mutate(spatial_id = as.character(spatial_id))
      
      tenure_df <- tenure_sum %>%
        rename(spatial_id = 1) %>%
        pivot_longer(
          cols = -spatial_id,
          names_to = "boot",
          values_to = "abundance"
        ) %>%
        mutate(
          spp = spp.i,
          YEAR = yr,
          spatial_level = "Tenure",
          spatial_id = as.character(spatial_id),
          boot = rep(seq_len(nlyr(r)), times = nrow(tenure_sum))
        ) %>%
        left_join(
          tenure_npix,
          by = "spatial_id"
        ) %>%
        select(
          spp, 
          YEAR, 
          boot,
          spatial_level, 
          spatial_id,
          abundance, 
          total_pixels
        )
     
     rm(tenure_sum,tenure_npix)
     gc()
      
      print("done Tenure stats")
      
  
# --------------------------------------------------------- 
# Combine the FIVE spatial summaries 
# ---------------------------------------------------------
     
        results[[as.character(yr)]] <- bind_rows(
          can_df,
          bcr_df,
          sub_df,
          sub10_df,
          FMU_df,
          tenure_df
        )
        
        print(paste0("done ",yr))
    }
    
    final_results <-bind_rows(results) 
    rm(can_df, bcr_df, sub_df,FMU_df,tenure_df)
    gc()
    
    # Explicitly return the data frame
    return(final_results)
}

