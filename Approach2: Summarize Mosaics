root <-"./data"
root2 <-"./LandChangeOutputs/TruncatedMosaic"
root3 <-"./LandChangeSummary"
##---------------------------------------------------------------------------------

# HPC args --------------
args    <- commandArgs(trailingOnly = TRUE)
task_id <- as.integer(args[1])

# Stable job list (sorted so task_id -> species never changes) ----
Indicators<-read.csv(file.path(root,"IndicatorSpecies_Drake_etal_CJFR.csv")) %>%
subset(.,.$Class!=".") %>%
subset(.,.$scale=="200m" & .$S>0.4055)%>% pull(species) %>% unique()
jobs <- Indicators

if (is.na(task_id) || task_id < 1 || task_id > length(jobs)) {
  message("task_id ", task_id, " outside 1..", length(jobs), "; nothing to do.")
  quit(save = "no", status = 0)
}
spp.i <- jobs[task_id]
print(paste("Task", task_id, "->", spp.i))

# Skip if already summarised --------------
out_file <- file.path(root3, paste0("SummaryStatsMosaic_", spp.i, ".csv"))
if (file.exists(out_file)) {
  message("Already done: ", out_file)
  quit(save = "no", status = 0)
}

#----------------------------------------------------------------------
# Check that all prediction years are there? If not, stop the process
#----------------------------------------------------------------------
 
      s <- list.files(root2)%>%
      .[. %like% spp.i]
      
      # Check if file exists, else skip ---------------------
      if (length(s)<2) { stop(sprintf("Too few files (%d/2) for spp: %s. Aborting.", length(s), spp.i))
      }
rm(s)
gc()
     
#--------------------------------------
# Bring in Spatial components
#--------------------------------------
print("importing species extent")

# get the mosaic extent
paths <- file.path(root2,paste0(spp.i, "_1990.tif"))
extent<- rast(paths)|>mean(na.rm=T)
e_valid <- ifel(!is.na(extent), 1, NA)

mask <- as.polygons(e_valid, dissolve = TRUE) |> 
  st_as_sf()

mask <- st_make_valid(mask)   # right after you build mask

# Function for clipping extents ---------
clip_to_mask <- function(x) {
  x |> st_make_valid() |> st_buffer(0) |>   # fix bad rings
    st_crop(mask) |> st_intersection(mask) |>
    st_make_valid() |> dplyr::filter(!st_is_empty(geometry))
}
  
rm(extent,e_valid)

# Get BCR extent --------------------
can <- read_sf(file.path(root,"CAN_adm0.shp")) |> #"Regions", "CAN_adm",
  st_transform(crs=5072) # Canadian boundary

bcr<- read_sf(file.path(root,"BAM_BCR_NationalModel.shp")) |> #, "Regions"
  st_transform(crs=5072)|> st_intersection(can)

bcr$subUnit<-paste0("can",bcr$subUnit)

print("masking bcr to species extent")

bcr.i<-bcr |> clip_to_mask()
gc()
print("done importing BCRs")

#-----------------------------------------
# Prepare all layers to this BCR extent 
#-----------------------------------------
# Watermask -----------
print("starting water layer import")

watermask.i<-read_sf(file.path(root,"water5072.shp")) %>%
  st_crop(mask) %>%   #2, "gis"  #st_intersection(can)%>% 
  st_make_valid() %>% filter(!st_is_empty(.))

print("done water layer import")

# Watersheds level 8 --------
wshed.i<-read_sf(file.path(root,"Level8AllCanadaWatersheds.shp"))|> clip_to_mask() # source is Hydrobasin for arctic and North America

# Watersheds level 10 --------
wshed10.i<-read_sf(file.path(root,"Canadian_Level10_5072.shp"))|> clip_to_mask()

# FMU --------
FMU.i<-read_sf(file.path(root,"FMU_5072.shp"))|> clip_to_mask()

# Tenure layer ----------
tenure.i<-rast(file.path(root,"LandTenure1k.tif")) %>% 
 crop(vect(mask)) %>% 
 mask(vect(watermask.i), inverse = TRUE) %>% mask(vect(mask))

print("done importing layers")

# Events ----
#distevent.i<-rast(file.path(root,"DisturbanceEvents.tif"))%>%crop(bcr.i)%>%mask(bcr.i) %>% mask(vect(watermask.i), inverse =TRUE) #2

#------------------------------------------
# Now run summary for spp.i and bcr.i:

print("starting summary stats...")

  out <- process_species(
    can=can,
    mask=mask,
    bcr.i=bcr.i,
    spp.i = spp.i,
    root2 = root2,
    wshed.i = wshed.i,
    wshed10.i = wshed10.i,
    tenure.i = tenure.i,
    watermask.i = watermask.i,
    FMU.i=FMU.i
  )%>% as.data.frame()
 
 # Add columns --------------
  
 out$dens <-out$abundance/out$total_pixels
 
print("done summary...saving....")

#---------------------------------------
# Write out the outputs 
#---------------------------------------  
write.csv(out,file.path(root3,paste0("SummaryStatsMosaic_", spp.i, ".csv")),row.names = FALSE)

