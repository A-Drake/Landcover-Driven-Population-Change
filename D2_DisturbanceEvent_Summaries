library(terra)
library(dplyr)
library(tidyr)
library(purrr)
library(sf)
library(data.table)

# Call Values ------
years <- seq(1985, 2020, by = 5)
nboot <- 32

#--------------------------------------------------------------------------------
# Function to summarize rasters across different land-divisions/conditions
#--------------------------------------------------------------------------------

process_species <- function(spp.i, bcr.i,bcrn.i,root2, watermask.i, distevent.i) {

    
    print(paste0("Running ", spp.i, " ", bcrn.i))

    results <- list()
    
    for (yr in years) {
      
      print(paste0("Year ", yr))
      f <- file.path(root2,paste0(bcrn.i, "_LandChangeOnly_", spp.i, "_", yr, ".tif"))
      
# Check if file exists, else skip (redundant with the year check) ---------------------
   if (!file.exists(f)) { stop(paste("Missing:", f))
   }
      
     # Import if does --------------- 
      r <- rast(f) # prediction outputs
    
# Check that there are 32 bootstrap estimates, else skip -------------
   if (nlyr(r) != nboot) {
   stop(paste0(spp.i, " ", yr, " has ", nlyr(r), " layers rather than ", nboot))
   }
      
      # Crop, mask, and remove water ----------------
      r <- r %>%crop(bcr.i)%>%mask(bcr.i) %>% mask(vect(watermask.i), inverse = TRUE)
      
      # Binary raster for sample size ----------------
      r_valid <- ifel(is.na(r[[1]]), 0, 1) %>% crop(bcr.i)%>%mask(bcr.i)
       
      # ---------------------------------------------------------
      # 4. Disturbance history
      # ---------------------------------------------------------
      # Get common extent 
      #common_ext <- intersect(ext(r), ext(distevent.i)) # some extent mismatches in coastal BCRs

      type_year_sum <- terra::zonal(r, distevent.i,fun = "sum",na.rm = TRUE)
      
      type_year_npix <- terra::zonal(r_valid, distevent.i, fun = "sum",na.rm = TRUE) %>%
        rename(zone = 1, total_pixels = 2)

     type_year_df <- type_year_sum %>%
        rename(zone = 1) %>%
        pivot_longer(
          cols = -zone,
          names_to = "boot",
          values_to = "abundance"
        ) %>%
        mutate(   
          spp = spp.i,
          YEAR = yr,
          boot = rep(seq_len(nlyr(r)), times = nrow(type_year_sum)),
          spatial_level = "Disturbance",
          val  = zone %/% 100000,
          Event_Type = val %/% 10000,
          Event_YR = val %% 10000,
          spatial_id = as.character(zone)
        ) %>%
        left_join(
          type_year_npix,
          by = "zone"
        ) %>%
        select(
          spp,
          YEAR,
          boot,
          spatial_level,
          Event_Type,
          Event_YR,
          spatial_id,
          abundance,
          total_pixels
        )
     rm(type_year_sum,type_year_npix)
     gc()
     print("done Disturbance stats") 

# --------------------------------------------------------- 
# Combine the four spatial summaries 
# ---------------------------------------------------------
     
        results[[as.character(yr)]] <- type_year_df
        
        print(paste0("done ",yr))
        rm(type_year_df)
    }
    
    final_results <-bind_rows(results) 
    rm(results)
    gc()
    
    # Explicitly return the data frame
    return(final_results)
}

